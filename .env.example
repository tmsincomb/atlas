# atlas environment variables
# atlas requires no secrets or credentials; all variables below are optional.

# Log verbosity. Allowed: DEBUG, INFO, WARNING, ERROR. Default: WARNING.
# ATLAS_LOG_LEVEL=WARNING

# Log output format. Allowed: json, text. Default: text.
# ATLAS_LOG_FORMAT=text

# Optional Sentry error tracking DSN. Requires: pip install "atlas-manifest[sentry]". Off when unset.
# SENTRY_DSN=

# Sentry environment name attached to error events. Default: local.
# SENTRY_ENVIRONMENT=local

# Feature flags: ATLAS_FLAG_<NAME>=1|true|yes|on (case-insensitive). Known flags: analytics (default: off).
# ATLAS_FLAG_ANALYTICS=false

# Opt-in usage analytics output file (JSONL). Default: ~/.atlas/analytics.jsonl
# ATLAS_ANALYTICS_FILE=
